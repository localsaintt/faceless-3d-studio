# Render output and large generated media (never commit; keep out of iCloud)
output/
renders/
**/frames/
*.mp4
*.mov
*.wav
*.exr
# Blender backups and caches
*.blend1
*.blend2
blendcache_*/
# Python
__pycache__/
*.pyc
.venv/
# Local models
models/
# macOS
.DS_Store

# Doctor/run logs (results are summarised in docs/PROJECT_KNOWLEDGE.md)
logs/*.json

# Obsidian: keep shared settings, ignore per-device state
.obsidian/workspace*.json
.obsidian/cache
# Rendered media embedded in notes (large; finished videos are archived to iCloud)
videos/*/media/
# Narration cache
output/cache/
